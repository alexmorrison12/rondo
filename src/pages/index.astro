---
import Cta from '@/components/Cta.astro';
import Base from '@/layouts/Base.astro';
import { COLORWAYS, PHASES, PHASE_ORDER, PRODUCT, formatPrice, perMonthOverTenYears } from '@/data/site';
import { ICONS } from '@/lib/icons';
import { url } from '@/lib/url';
import { ENGINES } from '@/scripts/seq/model';
import { PRESETS } from '@/scripts/seq/presets';

const perMonth = formatPrice(perMonthOverTenYears(PRODUCT.price), { cents: true });
const quarter = formatPrice(PRODUCT.price / 4, { cents: true });
const loops = PRESETS.slice(1, 9);
const standard = COLORWAYS.filter((c) => !c.foundersOnly);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Rondo',
  description: PRODUCT.oneLiner,
  brand: { '@type': 'Brand', name: 'Rondo' },
  offers: { '@type': 'Offer', price: PRODUCT.price, priceCurrency: 'USD', availability: 'https://schema.org/PreOrder' },
};
---

<Base
  title="Rondo"
  description="Rondo is a palm-sized instrument with four turning rings. Tap a ring to place a note, turn it to shift the groove. Play it right here, in your browser."
  surface="sky"
  bodyClass="page-home"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <noscript><style>.stage{display:none!important}.stage-fallback{display:block!important}</style></noscript>
  </Fragment>
  <Fragment slot="stage">
    <canvas class="stage" data-stage aria-hidden="true"></canvas>
    <div class="stage-fallback" data-stage-fallback aria-hidden="true" style={`--fallback-img: url(${url('/renders/rondo-hero.webp')})`}></div>
    <p class="sky-clock" data-sky-clock aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18"
        ><path d="M3 17a9 9 0 0 1 18 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
        ></path><circle data-sky-sun cx="12" cy="8" r="2.4" fill="currentColor"></circle></svg
      >
      <span class="num" data-sky-time>08:40</span>
      <span data-sky-label>Morning</span>
    </p>
  </Fragment>

  <!-- 1 · Hero ─────────────────────────────────────────── -->
  <section class="scene hero" data-scene="hero" data-sky="0.9" aria-labelledby="hero-title">
    <div class="wrap hero__inner">
      <p class="phase-note" data-phase-status>Pre-orders open</p>
      <h1 id="hero-title" class="hero__title" data-breathe>
        <span class="hero__line">Play in</span>
        <span class="hero__line">circles.</span>
      </h1>
      <p class="lead hero__lead">
        Rondo is a palm-sized instrument with four aluminium rings. Tap one to place a note, turn it to change the groove.
        Your first song takes ten seconds. The rest take years.
      </p>
      <div class="hero__actions">
        <Cta size="lg" showPrice />
        <button class="btn btn--ghost btn--lg" type="button" data-hear aria-pressed="false">
          <span data-hear-icon set:html={ICONS.play} />
          <span data-hear-label>Hear it</span>
        </button>
      </div>
      {
        PHASE_ORDER.map((p) => (
          <ul class="trust hero__trust" role="list" data-in-phase={p}>
            {PHASES[p].trust.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        ))
      }
    </div>
    <p class="device-hint" data-device-hint hidden>Tap the rings. Tap the sun to play.</p>
  </section>

  <!-- 2 · Three moves ───────────────────────────────────── -->
  <section class="scene manual" data-scene="manual" data-sky="1.3" aria-labelledby="manual-title">
    <div class="manual__sticky">
      <div class="wrap manual__inner">
        <h2 id="manual-title" class="display-l">The whole manual<br />is three moves.</h2>
        <ol class="moves" role="list" data-moves>
          <li class="move" data-move="0" data-state="active">
            <span class="move__n num">1</span>
            <div>
              <h3 class="title">Tap a ring to place a note.</h3>
              <p>Each ring is a loop. Tap anywhere on it and a light appears; when the sweep passes, it plays.</p>
              <p class="move__try"><span data-try>Tap a ring on the Rondo</span> <button class="move__show" type="button" data-show-move="0">Show me</button></p>
            </div>
          </li>
          <li class="move" data-move="1">
            <span class="move__n num">2</span>
            <div>
              <h3 class="title">Turn a ring to shift the groove.</h3>
              <p>Same notes, new rhythm. The rings turn on steel bearings and click into place like a watch bezel.</p>
              <p class="move__try"><span data-try>Drag around a ring</span> <button class="move__show" type="button" data-show-move="1">Show me</button></p>
            </div>
          </li>
          <li class="move" data-move="2">
            <span class="move__n num">3</span>
            <div>
              <h3 class="title">Tilt to open the sound.</h3>
              <p>Rondo knows which way is up. Tip it towards you and the sound opens like a window.</p>
              <p class="move__try"><span data-try>Move your pointer up and down</span> <button class="move__show" type="button" data-show-move="2">Show me</button></p>
            </div>
          </li>
        </ol>
        <div class="manual__done" data-manual-done hidden>
          <p class="title">That's everything. The rest is taste.</p>
          <div class="manual__done-actions">
            <a class="btn btn--ink" href={url('/play/')} data-keep-loop>Keep playing this loop <Fragment set:html={ICONS.arrowRight} /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · Polymeter ─────────────────────────────────────── -->
  <section class="scene rings" data-scene="rings" data-sky="2.2" aria-labelledby="rings-title">
    <div class="wrap rings__inner">
      <div class="rings__copy">
        <h2 id="rings-title" class="display-l">Four rings that never quite agree.</h2>
        <p class="lead">
          Each ring loops at its own length. Pulse plays drums over sixteen steps, Root plays bass over twelve, Glow plays
          chords over eight and Spark plays a melody over seven. They drift apart and fall back into line, so a loop keeps
          changing without you touching it.
        </p>
        <div class="lcm" aria-live="polite">
          <p class="lcm__label">Change Spark's length:</p>
          <div class="chip-row" role="radiogroup" aria-label="Spark ring length" data-spark-steps>
            {
              [5, 6, 7, 9, 11].map((n) => (
                <button class="chip" type="button" role="radio" aria-checked={n === 7 ? 'true' : 'false'} data-n={n}>
                  {n} steps
                </button>
              ))
            }
          </div>
          <p class="lcm__result">
            Together they repeat every <strong class="num" data-lcm>336</strong> steps, which is{' '}
            <strong class="num" data-bars>21</strong> bars before the same moment comes round again.
          </p>
        </div>
      </div>
      <figure class="orbit-diagram" aria-label="Four rings with 16, 12, 8 and 7 steps drifting against each other">
        <svg viewBox="-200 -200 400 400" data-orbits role="img" aria-hidden="true"></svg>
        <figcaption class="orbit-diagram__legend">
          <span style="--c: var(--ember)" class="engrave">Pulse · 16</span>
          <span style="--c: var(--sunlit)" class="engrave">Root · 12</span>
          <span style="--c: var(--tide)" class="engrave">Glow · 8</span>
          <span style="--c: var(--lilac)" class="engrave" data-spark-label>Spark · 7</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 4 · Voices ────────────────────────────────────────── -->
  <section class="scene voices" data-scene="voices" data-sky="3.1" aria-labelledby="voices-title">
    <div class="wrap voices__inner">
      <div class="voices__head">
        <h2 id="voices-title" class="display-l">Five voices. Zero samples.</h2>
        <p class="lead">
          Every sound is synthesised as you play it: a string modelled in software, bells made of frequency modulation,
          warm tape chords, a round bass and a dusty drum kit. Nothing is a recording, so nothing sounds quite the same
          twice.
        </p>
      </div>
      <ul class="voice-list" role="list" data-voices>
        {
          ENGINES.map((e, i) => (
            <li>
              <button class="voice" type="button" data-voice={e.id} aria-pressed="false">
                <span class="voice__n engrave num">0{i + 1}</span>
                <span class="voice__name">{e.name}</span>
                <span class="voice__blurb">{e.blurb}</span>
                <span class="voice__play" aria-hidden="true" set:html={ICONS.play} />
                <canvas class="voice__scope" width="240" height="48" aria-hidden="true" />
              </button>
            </li>
          ))
        }
      </ul>
      <p class="voices__foot">
        And it is very hard to play a wrong note: every ring is locked to one of twelve scales, from bright Lydian to
        moonlit Hirajōshi.
      </p>
    </div>
  </section>

  <!-- 5 · Craft / exploded ──────────────────────────────── -->
  <section class="scene craft" data-scene="craft" data-sky="4.1" aria-labelledby="craft-title">
    <div class="craft__sticky">
      <div class="wrap craft__inner">
        <h2 id="craft-title" class="display-l craft__title">Built like a watch.<br />Played like a toy.</h2>
        <ul class="callouts" role="list">
          <li data-callout="0"><strong>Unibody aluminium,</strong> bead-blasted, then anodised in four colours.</li>
          <li data-callout="1"><strong>Four turned rings</strong> on stainless bearings, with magnetic detents you can feel.</li>
          <li data-callout="2"><strong>384 micro-LEDs</strong> under frosted glass, so any rhythm fits any ring.</li>
          <li data-callout="3"><strong>A sapphire sun.</strong> Press to play, turn to change tempo.</li>
          <li data-callout="4"><strong>A 28 mm driver</strong> with a passive radiator. Big sound for a pocket.</li>
          <li data-callout="5"><strong>A 14-hour battery</strong> held in by four screws, not glue.</li>
        </ul>
        <dl class="specs engrave">
          <div><dt>Diameter</dt><dd>108 mm</dd></div>
          <div><dt>Weight</dt><dd>238 g</dd></div>
          <div><dt>Battery</dt><dd>14 h</dd></div>
          <div><dt>Ports</dt><dd>USB-C · MIDI in/out · 3.5 mm</dd></div>
          <div><dt>Wireless</dt><dd>Bluetooth MIDI</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- 6 · Promise ───────────────────────────────────────── -->
  <section class="scene promise on-dark" data-scene="promise" data-sky="5.45" data-header-theme="night" aria-labelledby="promise-title">
    <div class="wrap promise__inner">
      <h2 id="promise-title" class="display-l">Built for the next ten years, not the next upgrade.</h2>
      <ol class="promises" role="list">
        <li><span><strong>No subscription. Ever.</strong> Every sound and every update is included in the price.</span></li>
        <li><span><strong>No account, no app, no cloud.</strong> It works on a mountain, on a plane, in 2037.</span></li>
        <li><span><strong>Open firmware.</strong> If we disappear, Rondo doesn't. The code is yours to keep.</span></li>
        <li><span><strong>Made to be opened.</strong> Parts at cost, repair guides online, a battery you can swap in five minutes.</span></li>
        <li><span><strong>Updates until 2037,</strong> promised in writing, on the receipt.</span></li>
      </ol>
      <p class="promise__math">
        <span class="promise__big num">{formatPrice(PRODUCT.price)}, once.</span>
        <span>No subscription, no expiry: {perMonth} a month over ten years, then still yours.</span>
      </p>
      <p class="promise__sign">— Ines &amp; Theo, who made it</p>
    </div>
  </section>

  <!-- 7 · Loops & people ────────────────────────────────── -->
  <section class="scene loops on-dark" data-scene="loops" data-sky="6.1" data-header-theme="night" aria-labelledby="loops-title">
    <div class="wrap">
      <div class="loops__head">
        <h2 id="loops-title" class="display-l">Everyone plays it differently.</h2>
        <a class="btn btn--ghost" href={url('/loops/')}>All loops <Fragment set:html={ICONS.arrowRight} /></a>
      </div>
    </div>
    <ul class="loop-rail" role="list" data-loop-rail>
      {
        loops.map((p) => (
          <li>
            <button class="loop-card" type="button" data-loop={p.id} aria-pressed="false">
              <canvas class="loop-card__face" aria-hidden="true" />
              <span class="loop-card__name">{p.pattern.name}</span>
              <span class="loop-card__meta">
                {p.author} · {p.place}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
    <div class="wrap proof" data-proof>
      <h3 class="proof__title">Proof you can check</h3>
      <ol class="proof__list" role="list">
        <li>
          <p class="proof__lead" data-proof-played>You can play it right now.</p>
          <p data-proof-played-text>
            Tap any ring on this page. That's the real sound engine, not a recording, and it plays the same on the
            instrument.
          </p>
        </li>
        <li>
          <p class="proof__lead">Read every line.</p>
          <p>
            The code for this site and its instrument is public, and Rondo OS will be open source (MIT) from day one.
            <a href="https://github.com/alexmorrison12/rondo">See the source</a>
          </p>
        </li>
        <li>
          <p class="proof__lead">Every promise, in writing.</p>
          <p>
            Updates until {PRODUCT.updatesUntil}, parts at cost, a battery you can change: it's printed on your receipt.
            <a href={url('/story/#promise')}>Read the promise</a>
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 8 · Offer ─────────────────────────────────────────── -->
  <section class="scene offer on-dark" data-scene="offer" data-sky="7" data-header-theme="night" id="buy" aria-labelledby="offer-title">
    <div class="wrap offer__inner">
      <div class="offer__card" data-offer>
        <h2 id="offer-title" class="display-m">Rondo, for {formatPrice(PRODUCT.price)}.</h2>
        <p class="soft">or {quarter} × 4, interest-free · <span data-phase-shipping>Ships spring 2027</span></p>
        <fieldset class="offer__finish">
          <legend class="field__label">Finish: <span data-finish-name>Noon · Anodised sky blue</span></legend>
          <div class="swatches" role="radiogroup" aria-label="Finish">
            {
              standard.map((c, i) => (
                <button
                  class="swatch"
                  type="button"
                  role="radio"
                  aria-checked={i === 0 ? 'true' : 'false'}
                  aria-label={`${c.name}: ${c.note}`}
                  data-finish={c.id}
                  style={`--sw: ${c.swatch}`}
                />
              ))
            }
          </div>
        </fieldset>
        <button class="btn btn--sun btn--lg btn--block" type="button" data-add-rondo>
          <Fragment set:html={ICONS.bag} /> <span data-add-label>Pre-order Noon</span>
        </button>
        <ul class="offer__list" role="list">
          <li><Fragment set:html={ICONS.check} /> Rondo, braided USB-C cable, wrist loop and a printed field guide</li>
          <li><Fragment set:html={ICONS.check} /> Free engraving on the base, up to 24 characters</li>
          <li><Fragment set:html={ICONS.check} /> {PRODUCT.trialNights}-night trial, free returns, {PRODUCT.warrantyYears}-year warranty</li>
        </ul>
        <a class="offer__founders" href={url('/lp/founders/')}>
          <span><strong>Founders Edition</strong> · numbered, black and brass, {formatPrice(PRODUCT.foundersPrice)}</span>
          <Fragment set:html={ICONS.arrowUpRight} />
        </a>
      </div>
    </div>
  </section>

  <!-- 9 · FAQ ───────────────────────────────────────────── -->
  <section class="scene faq-section on-dark" data-scene="faq" data-sky="7" data-header-theme="night" aria-labelledby="faq-title">
    <div class="wrap faq-section__inner">
      <h2 id="faq-title" class="display-m">Questions, answered straight.</h2>
      <div class="faq">
        <details>
          <summary>I'm not musical at all. Will I actually use it?</summary>
          <div>
            <p>
              That's who we designed it for. Every ring is locked to a scale, so there are no wrong notes, and the
              polymeter does the arranging for you. You can find out right now, before spending anything: the rings on
              this page are the real sound engine.
            </p>
          </div>
        </details>
        <details>
          <summary>Does it need an app, an account or a subscription?</summary>
          <div>
            <p>No, no and no. Rondo works on its own, out of the box, forever. Updates arrive over USB-C and are optional.</p>
          </div>
        </details>
        <details>
          <summary>Can I use it with my music software?</summary>
          <div>
            <p>
              Yes. Rondo is a class-compliant USB audio and MIDI device, with 3.5 mm TRS MIDI in and out and Bluetooth
              MIDI. It sends and receives clock, so it can lead or follow anything with a tempo.
            </p>
          </div>
        </details>
        <details>
          <summary>What happens if it breaks?</summary>
          <div>
            <p>
              For five years, we fix or replace it for free. After that we sell parts at cost and publish repair guides.
              The battery comes out with four T5 screws.
            </p>
          </div>
        </details>
        <details>
          <summary>When will it ship, and what if I change my mind?</summary>
          <div>
            <p data-in-phase="signal">
              Rondo is revealed on 17 November and ships in spring 2027. Joining the list costs nothing and commits you to
              nothing; when it ships you have {PRODUCT.trialNights} nights to return it.
            </p>
            <p data-in-phase="founders">
              Founders Editions ship first, in March 2027. The {formatPrice(PRODUCT.foundersDeposit)} deposit is refundable in
              full until yours ships, and you have {PRODUCT.trialNights} nights to return it after it arrives.
            </p>
            <p data-in-phase="launch">
              Pre-orders ship in spring 2027, in order, and nothing is charged until yours ships. Cancel any time before then,
              and you have {PRODUCT.trialNights} nights to return it after it arrives.
            </p>
            <p data-in-phase="orbit">
              Orders ship within two working days. You have {PRODUCT.trialNights} nights to return it after it arrives, for a
              full refund.
            </p>
          </div>
        </details>
      </div>
      <p class="faq-section__more">
        More in <a href={url('/support/')}>Support</a>, or play it first in <a href={url('/play/')}>Rondo Web</a>.
      </p>
    </div>
  </section>

  <aside class="buybar" data-buybar aria-label="Quick buy" inert>
    <span class="buybar__swatch" data-buybar-swatch aria-hidden="true"></span>
    <span class="buybar__name">Rondo · <span data-buybar-finish>Noon blue</span></span>
    <span class="buybar__price num">{formatPrice(PRODUCT.price)}</span>
    <Cta size="sm" />
  </aside>
</Base>

<style>
  @layer page {
    :global(body.page-home) {
      background: var(--sky-300);
    }
    .stage,
    .stage-fallback {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100lvh;
      z-index: var(--z-stage);
      display: block;
    }
    .stage-fallback {
      display: none;
      background:
        var(--fallback-img) 72% 50% / min(62vmin, 640px) no-repeat,
        linear-gradient(to bottom, var(--sky-500), var(--sky-100));
    }
    :global(html[data-webgl='false']) .stage {
      display: none;
    }
    :global(html[data-webgl='false']) .stage-fallback {
      display: block;
    }
    .scene {
      position: relative;
      z-index: var(--z-content);
    }
    /* Let pointer events fall through empty layout to the playable instrument behind. */
    .scene,
    .scene .wrap,
    .scene [class*='__inner'],
    .scene [class*='__sticky'] {
      pointer-events: none;
    }
    /* :global() so elements rendered by child components (e.g. <Cta>) are reached too. */
    .scene :global(:is(h1, h2, h3, p, a, button, ol, ul, figure, dl, fieldset, form, details, summary, blockquote, input, label, canvas, svg, .lcm, .offer__card, .loop-rail)) {
      pointer-events: auto;
    }
    .on-dark {
      --fg: var(--starlight);
      --fg-soft: var(--star-soft);
      --border: oklch(0.93 0.025 250 / 0.18);
      --focus: var(--sun);
      color: var(--fg);
    }

    /* Sky clock */
    .sky-clock {
      position: fixed;
      left: var(--gutter);
      bottom: calc(var(--s-4) + env(safe-area-inset-bottom));
      z-index: var(--z-sticky);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.45rem 0.8rem;
      border-radius: var(--r-pill);
      font-size: var(--text-label);
      font-weight: 620;
      font-stretch: 88%;
      color: var(--clock-fg, var(--ink));
      background: var(--clock-bg, oklch(1 0 0 / 0.55));
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      transition:
        color var(--t-panel) var(--ease-out),
        background-color var(--t-panel) var(--ease-out);
      pointer-events: none;
    }
    :global(body[data-dark='true']) .sky-clock {
      --clock-fg: var(--starlight);
      --clock-bg: oklch(0.21 0.045 262 / 0.6);
    }
    @media (max-width: 640px) {
      .sky-clock {
        display: none;
      }
    }

    /* 1 · Hero */
    .hero {
      min-height: 100svh;
      display: flex;
      align-items: flex-end;
      padding-block: calc(var(--header-h) + var(--s-7)) var(--s-8);
    }
    .hero__inner {
      display: grid;
      gap: var(--s-5);
      justify-items: start;
    }
    .hero__title {
      font-size: var(--text-display-xl);
      font-weight: 800;
      font-stretch: 125%;
      letter-spacing: -0.025em;
      line-height: 0.92;
      max-width: 9ch;
    }
    .hero__line {
      display: block;
    }
    .hero__lead {
      max-width: 34rem;
      color: var(--ink-sky-soft);
    }
    .hero__actions {
      display: flex;
      gap: var(--s-3);
      flex-wrap: wrap;
    }
    .hero__trust {
      color: var(--ink-sky-soft);
    }
    .hero__trust li + li::before {
      content: '·';
      margin-right: var(--s-3);
    }
    .hero__trust {
      gap: var(--s-3);
    }
    .device-hint {
      position: absolute;
      right: 12%;
      top: 22%;
      padding: 0.5rem 0.9rem;
      border-radius: var(--r-pill);
      background: var(--night-800);
      color: var(--starlight);
      font-size: var(--text-small);
      font-weight: 560;
      animation: hint-in var(--t-enter) var(--ease-out) both;
    }
    @keyframes hint-in {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
    }
    @media (max-width: 860px) {
      .hero {
        align-items: flex-end;
        padding-top: 52svh;
      }
      .device-hint {
        right: 50%;
        translate: 50% 0;
        top: 44svh;
      }
    }

    /* Breathing type (driven by --breathe from the audio level) */
    [data-breathe] {
      font-variation-settings: 'wdth' calc(118 + var(--breathe, 0) * 7), 'wght' calc(780 + var(--breathe, 0) * 120);
    }

    /* 2 · Manual */
    .manual {
      height: 220vh;
    }
    .manual__sticky {
      position: sticky;
      top: 0;
      height: 100svh;
      display: flex;
      align-items: center;
    }
    .manual__inner {
      display: grid;
      gap: var(--s-6);
      align-content: center;
    }
    .manual__inner > * {
      max-width: 34rem;
    }
    /* Two lines, so the lesson and its finish line fit a laptop screen. */
    .manual__inner > h2 {
      max-width: 44rem;
    }
    .moves {
      display: grid;
