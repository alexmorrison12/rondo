---
import Base from '@/layouts/Base.astro';
import { PAYMENT, PRODUCT } from '@/data/site';
import { ICONS } from '@/lib/icons';
import { url } from '@/lib/url';

const countries = ['United States', 'Canada', 'United Kingdom', 'Ireland', 'Portugal', 'Spain', 'France', 'Germany', 'Netherlands', 'Sweden', 'Denmark', 'Norway', 'Japan', 'Australia', 'New Zealand'];
---

<Base
  title="Checkout"
  description="Secure checkout for Rondo pre-orders."
  og="shop"
  surface="haze"
  bodyClass="page-checkout"
  minimal
  noindex
>
  <div class="checkout wrap">
    <div class="checkout__main">
      <a class="back" href={url('/shop/')}><Fragment set:html={ICONS.arrowRight} /> Back to shop</a>
      <h1 class="display-m">Checkout</h1>
      <p class="demo-note">
        <Fragment set:html={ICONS.lock} />
        <span>This is a design prototype: no payment is taken and no card details are requested. Everything else works.</span>
      </p>

      <form class="co-form" data-checkout novalidate>
        <section class="co-step" aria-labelledby="step-contact">
          <h2 id="step-contact" class="co-step__title"><span class="co-step__n num" aria-hidden="true">1</span> Contact</h2>
          <div class="field">
            <label for="co-email">Email</label>
            <input class="input" id="co-email" name="email" type="email" autocomplete="email" required inputmode="email" />
            <p class="field__error" data-error-for="email" hidden></p>
          </div>
          <label class="check">
            <input type="checkbox" name="news" />
            <span>Send me Field notes: one email a month with a new loop.</span>
          </label>
        </section>

        <section class="co-step" aria-labelledby="step-delivery">
          <h2 id="step-delivery" class="co-step__title"><span class="co-step__n num" aria-hidden="true">2</span> Delivery</h2>
          <div class="grid-2">
            <div class="field">
              <label for="co-first">First name</label>
              <input class="input" id="co-first" name="first" autocomplete="shipping given-name" required />
              <p class="field__error" data-error-for="first" hidden></p>
            </div>
            <div class="field">
              <label for="co-last">Last name</label>
              <input class="input" id="co-last" name="last" autocomplete="shipping family-name" required />
              <p class="field__error" data-error-for="last" hidden></p>
            </div>
          </div>
          <div class="field">
            <label for="co-address">Address</label>
            <input class="input" id="co-address" name="address" autocomplete="shipping address-line1" required />
            <p class="field__error" data-error-for="address" hidden></p>
          </div>
          <details class="more">
            <summary>Add apartment, suite or floor</summary>
            <div class="field">
              <label for="co-address2">Apartment, suite, floor</label>
              <input class="input" id="co-address2" name="address2" autocomplete="shipping address-line2" />
            </div>
          </details>
          <div class="grid-3">
            <div class="field">
              <label for="co-city">City</label>
              <input class="input" id="co-city" name="city" autocomplete="shipping address-level2" required />
              <p class="field__error" data-error-for="city" hidden></p>
            </div>
            <div class="field">
              <label for="co-zip">Postcode</label>
              <input class="input" id="co-zip" name="zip" autocomplete="shipping postal-code" required />
              <p class="field__error" data-error-for="zip" hidden></p>
            </div>
            <div class="field">
              <label for="co-country">Country</label>
              <select class="select" id="co-country" name="country" autocomplete="shipping country-name">
                {countries.map((c) => <option>{c}</option>)}
              </select>
            </div>
          </div>
          <label class="check">
            <input type="checkbox" name="gift" data-gift-toggle />
            <span>This is a gift. We'll hide prices and add a handwritten card.</span>
          </label>
          <div class="field" data-gift-note hidden>
            <label for="co-gift">Your message <span class="soft">(printed on the card)</span></label>
            <textarea class="textarea" id="co-gift" name="giftMessage" rows="3" maxlength="200"></textarea>
          </div>
        </section>

        <section class="co-step" aria-labelledby="step-pay">
          <h2 id="step-pay" class="co-step__title"><span class="co-step__n num" aria-hidden="true">3</span> Payment</h2>
          <div class="pay-options" role="radiogroup" aria-label="Payment plan">
            <label class="pay-option">
              <input type="radio" name="plan" value="full" checked />
              <span><strong>Pay in full</strong><span class="soft" data-plan-full-note>{PAYMENT.standardLine()}</span></span>
              <span class="num" data-plan-full></span>
            </label>
            <label class="pay-option">
              <input type="radio" name="plan" value="four" />
              <span><strong>Pay in 4, interest-free</strong><span class="soft" data-plan-four-note>{PAYMENT.payInFourLine(PRODUCT.price)}</span></span>
              <span class="num" data-plan-four></span>
            </label>
          </div>
          <p class="soft co-fine">
            {PAYMENT.cancel} You have {PRODUCT.trialNights} nights to return it after it arrives. {PAYMENT.tax}
          </p>
        </section>

        <button class="btn btn--ink btn--lg btn--block" type="submit" data-place>
          <Fragment set:html={ICONS.lock} /> <span data-place-label>Place pre-order</span>
        </button>
      </form>
    </div>

    <aside class="summary" aria-labelledby="summary-title">
      <h2 id="summary-title" class="title">Your order</h2>
      <ul class="summary__lines" role="list" data-summary-lines></ul>
      <details class="promo-wrap">
        <summary>Have a code?</summary>
        <form class="promo" data-promo>
          <label class="visually-hidden" for="promo">Promo code</label>
          <input class="input" id="promo" name="promo" placeholder="Promo code" autocomplete="off" />
          <button class="btn btn--ghost" type="submit">Apply</button>
        </form>
      </details>
      <p class="promo__msg" data-promo-msg aria-live="polite"></p>
      <dl class="summary__totals" data-summary-totals></dl>
      <ul class="trust" role="list">
        <li><Fragment set:html={ICONS.shield} /> 100-night trial</li>
        <li><Fragment set:html={ICONS.truck} /> Free shipping</li>
        <li><Fragment set:html={ICONS.wrench} /> 5-year warranty</li>
      </ul>
    </aside>
  </div>
</Base>

<style>
  @layer page {
    .checkout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 26rem);
      gap: var(--s-8);
      padding-top: calc(var(--header-h) + var(--s-6));
      padding-bottom: var(--section-tight);
      align-items: start;
    }
    .checkout__main {
      display: grid;
      gap: var(--s-5);
      max-width: 40rem;
    }
    .back {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: var(--text-small);
      text-decoration: none;
      color: var(--ink-soft);
      width: fit-content;
    }
    .back :global(svg) {
      width: 1rem;
      height: 1rem;
      rotate: 180deg;
    }
    .demo-note {
      display: flex;
      gap: var(--s-3);
      align-items: flex-start;
      padding: var(--s-3) var(--s-4);
      border-radius: var(--r-panel);
      background: var(--haze-2);
      font-size: var(--text-small);
      color: var(--ink-soft);
    }
    .demo-note :global(svg) {
      width: 1.1rem;
      height: 1.1rem;
      flex: none;
      margin-top: 0.15rem;
    }
    .co-form {
      display: grid;
      gap: var(--s-7);
    }
    .co-step {
      display: grid;
      gap: var(--s-4);
    }
    .co-step__title {
      display: flex;
      align-items: center;
      gap: var(--s-3);
      font-size: var(--text-title);
      font-stretch: 110%;
    }
    .co-step__n {
      width: 2rem;
      height: 2rem;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--ink);
      color: var(--sun);
      font-size: 0.9375rem;
      font-weight: 700;
      font-stretch: 100%;
    }
    .grid-2,
    .grid-3 {
      display: grid;
      gap: var(--s-4);
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .grid-3 {
      grid-template-columns: 1.3fr 1fr 1.3fr;
    }
    .check {
      display: flex;
      gap: var(--s-3);
      align-items: flex-start;
      font-size: var(--text-small);
      cursor: pointer;
    }
    .check input {
      width: 1.15rem;
      height: 1.15rem;
      margin-top: 0.15rem;
      accent-color: var(--ink);
      flex: none;
    }
    .more summary {
      cursor: pointer;
      font-size: var(--text-small);
      font-weight: 600;
      width: fit-content;
      margin-bottom: var(--s-3);
    }
    .pay-options {
      display: grid;
      gap: var(--s-2);
    }
    .pay-option {
      display: grid;
      grid-template-columns: 1.2rem 1fr auto;
      gap: var(--s-3);
      align-items: start;
      padding: var(--s-4);
      border-radius: var(--r-panel);
      background: var(--white);
      box-shadow: inset 0 0 0 1px var(--line);
      cursor: pointer;
    }
    .pay-option:has(input:checked) {
      box-shadow: inset 0 0 0 2px var(--ink);
    }
    .pay-option input {
      accent-color: var(--ink);
      width: 1.1rem;
      height: 1.1rem;
      margin-top: 0.2rem;
    }
    .pay-option > span:nth-of-type(1) {
      display: grid;
      gap: 0.15rem;
    }
    .pay-option .soft {
      font-size: var(--text-small);
    }
    .co-fine {
      font-size: var(--text-small);
    }
    .summary {
      position: sticky;
      top: calc(var(--header-h) + var(--s-5));
      display: grid;
      gap: var(--s-5);
      padding: var(--s-6);
      border-radius: var(--r-panel-l);
      background: var(--white);
      box-shadow: var(--shadow-2);
    }
    .summary__lines {
      display: grid;
      gap: var(--s-4);
    }
    .summary__lines :global(li) {
      display: grid;
      grid-template-columns: 3.25rem 1fr auto;
      gap: var(--s-3);
      align-items: center;
      font-size: var(--text-small);
    }
    .summary__lines :global(.bag-thumb) {
      width: 3.25rem;
      height: 3.25rem;
    }
    .summary__lines :global(.line-name) {
      font-weight: 650;
      font-size: var(--text-body);
    }
    .summary__lines :global(.line-variant) {
      color: var(--ink-soft);
    }
    .promo-wrap summary {
      cursor: pointer;
      width: fit-content;
      font-size: var(--text-small);
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 0.2em;
      list-style: none;
    }
    .promo-wrap summary::-webkit-details-marker {
      display: none;
    }
    .promo-wrap[open] summary {
      margin-bottom: var(--s-3);
    }
    .promo {
      display: flex;
      gap: var(--s-2);
    }
    .promo .input {
      flex: 1;
    }
    .promo__msg {
      font-size: var(--text-small);
      margin-top: calc(var(--s-4) * -1);
      min-height: 1.2em;
    }
    .promo__msg[data-ok='true'] {
      color: var(--success);
    }
    .promo__msg[data-ok='false'] {
      color: var(--danger);
    }
    .summary__totals {
      display: grid;
      gap: var(--s-2);
      padding-top: var(--s-4);
      border-top: 1px solid var(--line);
      font-size: var(--text-small);
    }
    .summary__totals :global(div) {
      display: flex;
      justify-content: space-between;
    }
    .summary__totals :global(dd) {
      margin: 0;
      font-weight: 600;
    }
    .summary__totals :global(.total) {
      font-size: 1.25rem;
      font-weight: 760;
      padding-top: var(--s-2);
      border-top: 1px solid var(--line);
    }
    .summary .trust {
      justify-content: space-between;
      font-size: var(--text-label);
    }
    @media (max-width: 960px) {
      .checkout {
        grid-template-columns: 1fr;
        gap: var(--s-6);
      }
      .summary {
        position: static;
        order: -1;
      }
      .grid-3 {
        grid-template-columns: 1fr 1fr;
      }
      .grid-3 > :last-child {
        grid-column: 1 / -1;
      }
    }
  }
</style>

<script>
  import '@/scripts/pages/checkout';
</script>
