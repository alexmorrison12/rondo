---
import { NAV, PHASES, PHASE_ORDER, SITE_MODE } from '@/data/site';
import { STARS } from '@/data/stars';
import { ICONS } from '@/lib/icons';
import { url } from '@/lib/url';
import Cta from './Cta.astro';
import Logo from './Logo.astro';
---

<!-- Bag -->
<dialog class="drawer" data-bag aria-labelledby="bag-title">
  <div class="drawer__head">
    <h2 id="bag-title" class="title">Your bag</h2>
    <button class="icon-btn" type="button" data-bag-close aria-label="Close bag">
      <Fragment set:html={ICONS.x} />
    </button>
  </div>
  <div class="drawer__body" data-bag-body></div>
  <div class="drawer__foot" data-bag-foot hidden></div>
</dialog>

<!-- Command palette -->
<dialog class="modal palette" data-palette aria-label="Command palette">
  <input
    class="palette__input"
    type="text"
    placeholder="Search pages and actions…"
    aria-label="Search pages and actions"
    role="combobox"
    aria-expanded="true"
    aria-controls="palette-list"
    autocomplete="off"
    spellcheck="false"
  />
  <ul class="palette__list" id="palette-list" role="listbox"></ul>
  <div class="palette__foot" aria-hidden="true">
    <span><kbd>↑</kbd> <kbd>↓</kbd> move</span><span><kbd>↵</kbd> open</span><span><kbd>esc</kbd> close</span>
  </div>
</dialog>

<!-- Orbit log (achievements) -->
<div id="orbit-log" class="orbit-log" popover aria-labelledby="orbit-title">
  <p id="orbit-title" class="title" style="font-size: 1.25rem">Orbit log</p>
  <svg class="orbit-log__map" viewBox="0 0 236 140" data-orbit-map aria-hidden="true"></svg>
  <ol>
    {
      STARS.map((s) => (
        <li data-star={s.id} data-earned="false">
          <span>
            <strong>{s.title}</strong> · <span class="orbit-log__hint">{s.hint}</span>
          </span>
        </li>
      ))
    }
  </ol>
  <p class="orbit-log__reward" data-orbit-reward></p>
</div>

<!-- Mobile menu -->
<dialog class="menu-sheet surface-night" data-menu aria-label="Menu">
  <div class="menu-sheet__top">
    <a class="brand" href={url('/')} aria-label="Rondo — home"><Logo /></a>
    <button class="icon-btn" type="button" data-menu-close aria-label="Close menu">
      <Fragment set:html={ICONS.x} />
    </button>
  </div>
  <nav aria-label="Mobile">
    <a href={url('/')}>Home</a>
    {NAV.map((item) => <a href={url(item.href)}>{item.label}</a>)}
    <a href={url('/shop/')}>Shop</a>
    <a href={url('/support/')}>Support</a>
  </nav>
  <Cta size="lg" block />
  <p class="soft" style="margin-top: var(--s-5); font-size: var(--text-small)">
    <span data-phase-status>Pre-orders open</span> · <span data-phase-shipping>Ships spring 2027</span>
  </p>
  <div class="menu-phase" role="group" aria-label="Preview a launch phase">
    <p class="engrave">Prototype · preview a launch phase</p>
    <div class="chip-row">
      {PHASE_ORDER.map((p) => <button class="chip" type="button" data-phase-pick={p} aria-pressed="false">{PHASES[p].name}</button>)}
    </div>
    <a href={url('/launch-plan/')}>Open the launch plan</a>
  </div>
</dialog>

<!-- Phase chip: which launch phase is the site presenting? (prototype / preview) -->
<div class="phase-chip" data-phase-chip data-previewing="false" data-mode={SITE_MODE} hidden={SITE_MODE === 'live'}>
  <button class="phase-chip__btn" type="button" popovertarget="phase-pop" aria-label="Launch phase preview">
    <span data-phase-chip-label>Prototype · Launch phase</span>
  </button>
</div>
<div id="phase-pop" class="phase-pop" popover aria-labelledby="phase-pop-title">
  <p id="phase-pop-title" class="title" style="font-size: 1.125rem; color: var(--starlight)">Launch phase</p>
  <p>This concept previews how the whole site changes as the launch moves forward. Previews last for this tab only.</p>
  <div class="phase-pop__list" role="group" aria-label="Preview a phase">
    {
      PHASE_ORDER.map((p) => (
        <button type="button" data-phase-pick={p} aria-pressed="false">
          <span>{PHASES[p].name}</span>
          <small>{PHASES[p].window}</small>
        </button>
      ))
    }
  </div>
  <div class="phase-pop__foot">
    <a href={url('/launch-plan/')}>Open the launch plan</a>
    <button type="button" data-phase-reset>Reset</button>
  </div>
</div>

<div class="toasts" data-toasts role="status" aria-live="polite"></div>
