---
import '@/styles/global.css';
import fontLatin from '@/assets/fonts/archivo-latin.woff2?url';
import Footer from '@/components/Footer.astro';
import GlobalUI from '@/components/GlobalUI.astro';
import Header from '@/components/Header.astro';
import { DEFAULT_PHASE, PHASE_ORDER, PRODUCT } from '@/data/site';
import { url } from '@/lib/url';

interface Props {
  title: string;
  description: string;
  /** Path under /public/og/, without extension. */
  og?: string;
  /** Page surface: sets default colours for body. */
  surface?: 'haze' | 'sky' | 'night';
  headerTheme?: 'day' | 'night';
  /** Landing pages: no primary nav, minimal footer. */
  minimal?: boolean;
  noindex?: boolean;
  bodyClass?: string;
  themeColor?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  og = 'default',
  surface = 'haze',
  headerTheme = surface === 'night' ? 'night' : 'day',
  minimal = false,
  noindex = false,
  bodyClass,
  themeColor = '#a9d9f1',
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL('https://alexmorrison12.github.io');
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL(url(`/og/${og}.png`), site).toString();
const fullTitle = title === PRODUCT.name ? `${PRODUCT.name} — ${PRODUCT.tagline}` : `${title} · ${PRODUCT.name}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Prerender same-site pages on hover intent for near-instant navigation (Speculation Rules API).
const speculation = {
  prerender: [
    {
      where: {
        and: [
          { href_matches: `${base}/*` },
          { not: { href_matches: `${base}/checkout/*` } },
          { not: { selector_matches: '[data-no-prerender]' } },
        ],
      },
      eagerness: 'moderate',
    },
  ],
};
---

<!doctype html>
<html lang="en" data-phase={DEFAULT_PHASE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content={surface === 'night' ? 'dark' : 'light'} />

    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rondo" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="speculationrules" is:inline set:html={JSON.stringify(speculation)} />
    <!-- Apply a per-tab phase preview before first paint (no flash of the wrong CTA). -->
    <script is:inline define:vars={{ phases: PHASE_ORDER }}>
      try {
        var q = new URLSearchParams(location.search).get('phase');
        var s = q && phases.indexOf(q) > -1 ? q : sessionStorage.getItem('rondo:phase-preview');
        if (s && phases.indexOf(s) > -1) document.documentElement.dataset.phase = s;
      } catch (e) {}
    </script>
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body class:list={[`surface-${surface}`, bodyClass]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header minimal={minimal} theme={headerTheme} />
    <slot name="stage" />
    <main id="main">
      <slot />
    </main>
    <Footer minimal={minimal} />
    <GlobalUI />
    <script>
      import '@/scripts/core/app';
    </script>
  </body>
</html>
